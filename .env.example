# HTTP server
PORT=3000
NODE_ENV=development
LOG_LEVEL=info

# Postgres (matches docker-compose service names)
DATABASE_URL=postgres://ledger:ledger@localhost:5432/ledger
PGPOOL_MAX=20
PGPOOL_IDLE_MS=30000

# Redis
REDIS_URL=redis://localhost:6379

# Idempotency cache TTL (seconds). 24h is the standard Razorpay/Stripe window.
IDEMPOTENCY_TTL_SECONDS=86400

# Node identity
NODE_ID=node-1
