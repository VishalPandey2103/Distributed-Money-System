# HTTP + gRPC per node — overridden per-service in docker-compose
NODE_ID=node-1
HTTP_PORT=3001
GRPC_PORT=6001
NODE_ENV=development
LOG_LEVEL=info

# Postgres and Redis addresses (per-node in v2 — each node has its own)
DATABASE_URL=postgres://ledger:ledger@localhost:5432/ledger
PGPOOL_MAX=20
PGPOOL_IDLE_MS=30000
REDIS_URL=redis://localhost:6379

# Idempotency cache TTL (24h — matches Razorpay/Stripe)
IDEMPOTENCY_TTL_SECONDS=86400

# Cluster membership. Comma-separated list of "id@grpcHost:grpcPort|httpBase".
# httpBase is only used by clients to redirect to the leader.
# Example: node-1@localhost:6001|http://localhost:3001,node-2@localhost:6002|http://localhost:3002,node-3@localhost:6003|http://localhost:3003
CLUSTER=node-1@localhost:6001|http://localhost:3001,node-2@localhost:6002|http://localhost:3002,node-3@localhost:6003|http://localhost:3003

# Raft timing (ms). Election timeout is randomized in [MIN, MAX].
RAFT_HEARTBEAT_MS=150
RAFT_ELECTION_TIMEOUT_MIN_MS=800
RAFT_ELECTION_TIMEOUT_MAX_MS=1500

# Max entries per AppendEntries batch
RAFT_MAX_BATCH=64

# How long a client proposal waits to be applied before returning 503.
RAFT_PROPOSE_TIMEOUT_MS=5000
